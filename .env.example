# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Dashboard → Project Settings → API

# URL do projeto (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do cliente. Use a publishable key (novos projetos) ou a anon key (legado).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE para o script de seed (scripts/seed.mjs). NUNCA exponha no frontend.
# Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Chave PIX exibida no pagamento (e-mail)
NEXT_PUBLIC_PIX_KEY=pedroeuller367@gmail.com

# Opcional: caminho público de um QR Code real, por exemplo /pix-qr.png
# Se vazio, o site gera um QR da chave PIX e mostra um placeholder para substituição.
NEXT_PUBLIC_PIX_QR_IMAGE=
