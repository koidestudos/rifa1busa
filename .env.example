# Copie este arquivo para .env.local e preencha com os dados do seu projeto Firebase.
# Console: https://console.firebase.google.com/

# ID do projeto (Project settings → General)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PROJECT_ID=

# Chave da Web API (Project settings → General → Web API Key)
# Pode ficar só no servidor; o login usa Identity Toolkit no Server Action.
FIREBASE_API_KEY=

# Conta de serviço (Project settings → Service accounts → Generate new private key)
# Cole o client_email e a private_key do JSON. Nunca exponha no frontend.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Chave PIX exibida no pagamento (e-mail)
NEXT_PUBLIC_PIX_KEY=pedroeuller367@gmail.com

# QR Code PIX. Se vazio, o site usa /pix-qr.png quando o arquivo existir.
NEXT_PUBLIC_PIX_QR_IMAGE=/pix-qr.png
